DJANGO_ENV=production
SECRET_KEY=replace-with-a-long-random-django-secret
SECRET_KEY_FALLBACKS=
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
FIELD_ENCRYPTION_KEY_FALLBACKS=
ALLOWED_HOSTS=intranet.example.com
CSRF_TRUSTED_ORIGINS=https://intranet.example.com
SITE_URL=https://intranet.example.com

POSTGRES_DB=benjamin_intranet
POSTGRES_USER=benjamin_intranet
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
CACHE_URL=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=intranet@example.com
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password
DEFAULT_FROM_EMAIL=intranet@example.com

GROQ_API_KEY=replace-with-the-groq-key
LEGIFRANCE_CLIENT_ID=replace-with-the-legifrance-client-id
LEGIFRANCE_CLIENT_SECRET=replace-with-the-legifrance-secret
LEGIFRANCE_ENV=prod
GOOGLE_CLIENT_ID=replace-with-the-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-the-google-client-secret
GOOGLE_REDIRECT_URI=https://intranet.example.com/oauth/callback/

SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912

# Classeur partagé de suivi des factures (vide = synchronisation désactivée)
INVOICE_EXCEL_SYNC_PATH=/data/shared/suivi_factures.xlsx
INVOICE_EXCEL_SYNC_SHEET=Factures
INVOICE_EXCEL_SYNC_HEADER_ROW=1
INVOICE_EXCEL_SYNC_CREATE_IF_MISSING=False

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Supervision d'erreurs (optionnelle mais recommandée)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_RELEASE=
